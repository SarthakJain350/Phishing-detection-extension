# ==============================================================================
# Environment Configuration Template — Phishing Attack Detector
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development.
# 2. Never commit actual '.env' files, API keys, or production passwords to Git.
# 3. Server-side secrets must remain on the backend only; never bundle into extension.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL Configuration (Local Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=phishing_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/phishing_db

# CORS Configuration
# Security Notice: Do not use wildcard 'chrome-extension://*' in production or local dev.
# Add your specific unpacked Chrome extension ID (obtained from chrome://extensions):
# Example: "chrome-extension://abcdefghijklmnopabcdefghijklmnop"
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","chrome-extension://<YOUR_EXTENSION_ID>"]

# External Detection Providers (Optional for local development / mocked slice)
# Leave blank to use MockDetectionOrchestrator and offline heuristics
GEMINI_API_KEY=
SAFE_BROWSING_API_KEY=

# Retention Policy (Days)
SCAN_RETENTION_DAYS=30
